# ==============================================================================
# EtechEdge Solutions - SMTP Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' on your local development machine (XAMPP) or live server:
#      cp .env.example .env
# 2. Replace the dummy values below with your actual SMTP server credentials.
# 3. NEVER commit the real '.env' file containing passwords to Git / GitHub.
#
# IMPORTANT:
# - The SMTP login account (SMTP_USERNAME / MAIL_FROM_ADDRESS) and the receiving email
#   (MAIL_TO_ADDRESS) are allowed and expected to be DIFFERENT.
#   Example:
#     SMTP_HOST=smtp.gmail.com
#     SMTP_PORT=587
#     SMTP_USERNAME=your-authenticated-account@gmail.com
#     SMTP_PASSWORD=your-16-char-gmail-app-password
#     SMTP_ENCRYPTION=tls
#     MAIL_FROM_ADDRESS=your-authenticated-account@gmail.com
#     MAIL_FROM_NAME=EtechEdge Solutions
#     MAIL_TO_ADDRESS=techgrowza@gmail.com
# ==============================================================================

# Outgoing SMTP Host (e.g. smtp.gmail.com, mail.etechedge.com)
SMTP_HOST=smtp.example.com

# SMTP Port: 587 for TLS (STARTTLS), 465 for SSL, or 25 (unencrypted)
SMTP_PORT=587

# SMTP Authentication Username (your authenticated Gmail address or SMTP username)
SMTP_USERNAME=your-smtp-username@example.com

# SMTP Authentication Password (e.g. Gmail 16-character App Password)
SMTP_PASSWORD=YOUR_DUMMY_SMTP_PASSWORD

# Encryption type: 'tls' (recommended for port 587) or 'ssl' (for port 465)
SMTP_ENCRYPTION=tls

# Sender Email and Name (Must match or be authorized by your SMTP account)
MAIL_FROM_ADDRESS=your-smtp-username@example.com
MAIL_FROM_NAME=EtechEdge Solutions

# Recipient Email for incoming website consultation/contact inquiries
MAIL_TO_ADDRESS=techgrowza@gmail.com
MAIL_TO_NAME=EtechEdge Inquiries
